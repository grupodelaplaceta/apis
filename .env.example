MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST.mongodb.net/?appName=TestBanco
MONGODB_DB=TestBanco
MONGODB_STATE_COLLECTION=bank_state
MONGODB_NONCE_COLLECTION=api_nonces
PLACETA_APP_IDS=org.laplaceta.banco,org.laplaceta.capitalia
PLACETA_APP_SECRET=replace-with-64-random-bytes-base64-or-hex
# También se acepta PLACETA_API_SECRET o PLACETA_APP_SECRETS separado por comas.
PLACETA_ID_JWT_SECRET=same-secret-as-placetaid-jwt
# También se acepta JWT_SECRET o PLACETA_ID_JWT_SECRETS separado por comas.
ALLOWED_ORIGINS=
